rules_version = '2';

// hunters-map Firestore database. Deployed by Terraform (infra/terraform/main.tf).
//
// Phones only read, and only the groups they belong to: the group, its members and the
// members' live positions. Every write goes through the Cloud Run API, whose service
// account bypasses these rules. Membership documents are created only by the API.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(groupId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    match /groups/{groupId} {
      allow read: if isMember(groupId);

      match /members/{userId} {
        allow read: if isMember(groupId);
      }

      match /locations/{userId} {
        allow read: if isMember(groupId);
      }
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else (invites, writes anywhere) is API-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
