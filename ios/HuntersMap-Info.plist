<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist; other keys come from INFOPLIST_KEY_* build settings. -->

	<!-- Track recording continues with the screen locked (TrackRecorder). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<!-- Google sign-in returns to the app through this URL scheme: REVERSED_CLIENT_ID from
	     GoogleService-Info.plist (make ios-config). Update both together. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.972743076858-uc2r5gn61jsgd5hb7o875v0r0epe3v0i</string>
			</array>
		</dict>
	</array>

	<!-- Maanmittauslaitos API key for the topo map and orthophotos: MML_API_KEY in
	     ios/Secrets.xcconfig (gitignored, see ios/Config.xcconfig). Empty = OpenTopoMap. -->
	<key>MMLAPIKey</key>
	<string>$(MML_API_KEY)</string>

	<!-- hunters-map backend (Cloud Run): terraform output api_url in infra/terraform. -->
	<key>HuntersMapAPIBaseURL</key>
	<string>https://hunters-map-api-nlpcgelvnq-lz.a.run.app</string>
</dict>
</plist>
